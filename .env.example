# DriveVault AI Environment Variables Configuration

# Google Drive OAuth 2.0 Credentials (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/callback

# Gemma AI Assistant Configuration
# Get API Key from Google AI Studio (https://aistudio.google.com/)
GEMMA_API_KEY=your_gemma_api_key
GEMMA_MODEL_NAME=gemma-2-9b-it

# Server Settings
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
